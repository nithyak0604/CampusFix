# Copy this file outside version control as .env, or configure these values in your IDE/terminal.
# Do not commit real credentials or JWT secrets.

DB_URL=jdbc:mysql://localhost:3306/campusfix?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=your_mysql_username
DB_PASSWORD=your_mysql_password
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters

# Optional settings
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
APP_UPLOAD_DIR=uploads
JPA_DDL_AUTO=update
